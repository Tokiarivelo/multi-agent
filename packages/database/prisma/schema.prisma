generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  firstName          String
  lastName           String
  password           String?
  role               UserRole            @default(USER)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  image              String?
  provider           String?             @default("credentials")
  settings           Json?               @default("{}")
  agents                    Agent[]
  apiKeys                   ApiKey[]
  executions                Execution[]
  collections               VectorCollection[]
  workflowExecutions        WorkflowExecution[]
  workflows                 Workflow[]
  files                     File[]
  chatSessions              ChatSession[]
  collaboratorEntries       WorkflowCollaborator[]    @relation("CollaboratorUser")
  collaboratorInvites       WorkflowCollaborator[]    @relation("CollaboratorInviter")
  workflowInvitations       WorkflowInvitation[]
  accessRequests            WorkflowAccessRequest[]   @relation("AccessRequester")
  workflowChangeLogs        WorkflowChangeLog[]
  notifications             Notification[]
  forkRequests              WorkflowForkRequest[]     @relation("ForkRequester")
  templateInstallations     WorkflowInstallation[]    @relation("UserInstallations")

  @@index([email])
  @@map("users")
}

model Workflow {
  id                 String               @id @default(uuid())
  userId             String
  name               String
  description        String?
  nodes              Json
  edges              Json
  status             WorkflowStatus       @default(DRAFT)
  visibility         WorkflowVisibility   @default(PRIVATE)
  forkedFromId       String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  definition         Json?
  isTemplate         Boolean   @default(false)
  category           String?
  tags               String[]
  installsCount      Int       @default(0)
  previewImageUrl    String?
  isFeatured         Boolean   @default(false)
  authorName         String?
  executions         Execution[]
  workflowExecutions WorkflowExecution[]
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailSubscriptions GmailWatchSubscription[]
  forkedFrom         Workflow?            @relation("WorkflowForks", fields: [forkedFromId], references: [id])
  forks              Workflow[]           @relation("WorkflowForks")
  collaborators      WorkflowCollaborator[]
  invitations        WorkflowInvitation[]
  accessRequests     WorkflowAccessRequest[]
  changeLogs         WorkflowChangeLog[]
  forkRequests       WorkflowForkRequest[]
  templateInstallations WorkflowInstallation[] @relation("TemplateInstallations")
  installedAs           WorkflowInstallation?  @relation("InstalledWorkflow")

  @@index([userId])
  @@index([status])
  @@index([visibility])
  @@index([isTemplate, category])
  @@index([isTemplate, isFeatured])
  @@index([isTemplate, visibility, isFeatured(sort: Desc), installsCount(sort: Desc), updatedAt(sort: Desc)], map: "idx_marketplace_listing")
  @@map("workflows")
}

model WorkflowCollaborator {
  id         String          @id @default(uuid())
  workflowId String
  userId     String
  role       CollaboratorRole
  invitedBy  String
  invitedAt  DateTime        @default(now())
  acceptedAt DateTime?
  status     InvitationStatus @default(PENDING)
  workflow   Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user       User             @relation("CollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)
  inviter    User             @relation("CollaboratorInviter", fields: [invitedBy], references: [id])

  @@unique([workflowId, userId])
  @@index([workflowId])
  @@index([userId])
  @@index([status])
  @@map("workflow_collaborators")
}

model WorkflowInvitation {
  id         String           @id @default(uuid())
  workflowId String
  email      String
  invitedBy  String
  role       CollaboratorRole
  token      String           @unique @default(uuid())
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  workflow   Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  inviter    User             @relation(fields: [invitedBy], references: [id])

  @@index([workflowId])
  @@index([email])
  @@index([token])
  @@index([status])
  @@map("workflow_invitations")
}

model WorkflowAccessRequest {
  id          String              @id @default(uuid())
  workflowId  String
  requesterId String
  status      AccessRequestStatus @default(PENDING)
  message     String?
  requestedAt DateTime            @default(now())
  respondedAt DateTime?
  workflow    Workflow            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  requester   User                @relation("AccessRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([workflowId, requesterId])
  @@index([workflowId])
  @@index([requesterId])
  @@index([status])
  @@map("workflow_access_requests")
}

model WorkflowChangeLog {
  id         String       @id @default(uuid())
  workflowId String
  userId     String
  action     ChangeAction
  details    Json
  createdAt  DateTime     @default(now())
  workflow   Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id])

  @@index([workflowId])
  @@index([userId])
  @@index([createdAt])
  @@map("workflow_change_logs")
}

model Agent {
  id           String           @id @default(uuid())
  userId       String
  name         String
  description  String?
  systemPrompt String?
  modelId      String
  tools        Json
  temperature  Float?           @default(0.7)
  maxTokens    Int?             @default(2000)
  isSystem     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  metadata     Json?
  executions   AgentExecution[]
  tokenUsage   TokenUsage[]
  model        Model            @relation(fields: [modelId], references: [id])
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([modelId])
  @@map("agents")
}

model AgentExecution {
  id          String          @id @default(uuid())
  agentId     String
  input       String
  output      String?
  tokens      Int?
  status      ExecutionStatus @default(PENDING)
  error       String?
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  agent       Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([status])
  @@map("agent_executions")
}

model Tool {
  id          String       @id @default(uuid())
  name        String       @unique
  description String
  category    ToolCategory
  parameters  Json
  code        String?
  isBuiltIn   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  icon        String?
  mcpConfig   Json?
  repoFullName String?

  @@index([category])
  @@index([isBuiltIn])
  @@map("tools")
}

model Model {
  id                    String        @id @default(uuid())
  name                  String        @unique
  provider              ModelProvider
  modelName             String
  maxTokens             Int
  supportsStreaming     Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  defaultTemperature    Float?
  description           String?
  inputCostPer1kTokens  Float?
  isActive              Boolean       @default(true)
  isDefault             Boolean       @default(false)
  metadata              Json?
  modelId               String?
  outputCostPer1kTokens Float?
  providerSettings      Json?
  rateLimitPerDay       Int?
  rateLimitPerHour      Int?
  rateLimitPerMinute    Int?
  agents                Agent[]

  @@index([provider])
  @@index([isActive])
  @@index([isDefault])
  @@map("models")
}

model ApiKey {
  id           String        @id @default(uuid())
  userId       String
  provider     ModelProvider
  encryptedKey String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  isActive     Boolean       @default(true)
  isValid      Boolean       @default(true)
  keyName      String?
  keyPrefix    String?
  lastUsedAt   DateTime?
  metadata     Json?
  usageCount   Int           @default(0)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
  @@index([userId, provider, keyName])
  @@map("api_keys")
}

model Execution {
  id          String          @id @default(uuid())
  workflowId  String
  userId      String
  status      ExecutionStatus @default(PENDING)
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  error       String?
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  logs        ExecutionLog[]
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow    Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([userId])
  @@index([status])
  @@index([startedAt])
  @@map("executions")
}

model ExecutionLog {
  id          String          @id @default(uuid())
  executionId String
  nodeId      String
  nodeName    String
  status      ExecutionStatus
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  duration    Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  execution   Execution       @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([nodeId])
  @@map("execution_logs")
}

model WorkflowExecution {
  id             String          @id @default(uuid())
  workflowId     String
  userId         String
  status         ExecutionStatus @default(PENDING)
  input          Json?
  output         Json?
  error          String?
  nodeExecutions Json?
  currentNodeId  String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow       Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([userId])
  @@index([status])
  @@map("workflow_executions")
}

model WorkflowHealingLog {
  id           String    @id @default(uuid())
  executionId  String
  nodeId       String
  nodeName     String?
  nodeType     String?
  errorMessage String
  errorContext Json
  suggestion   Json
  failureType  String    @default("TECHNICAL") // TECHNICAL | FUNCTIONAL
  strategy     String    // AUTO_FIX | MANUAL_APPROVAL | LOG_ONLY
  status       String    // PENDING | APPLIED | REJECTED | FAILED
  isTest       Boolean   @default(false)
  appliedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([executionId])
  @@index([failureType])
  @@map("workflow_healing_logs")
}

model VectorCollection {
  id               String   @id @default(uuid())
  userId           String
  name             String
  dimension        Int
  /// ID of the Model record in model-service used for embeddings (optional, falls back to env default)
  embeddingModelId String?
  /// ID of the ApiKey record in model-service used for embeddings (optional, falls back to env default)
  apiKeyId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("vector_collections")
}

model TokenUsage {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  userId        String
  agentId       String
  executionId   String?
  workflowId    String?
  nodeId        String?
  isTest        Boolean  @default(false)
  model         String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  totalTokens   Int      @default(0)
  inputPreview  String?
  outputPreview String?
  success       Boolean  @default(true)
  errorMessage  String?
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([agentId])
  @@index([isTest])
  @@index([timestamp])
  @@map("token_usage")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  payload   Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model WorkflowForkRequest {
  id          String            @id @default(uuid())
  workflowId  String
  requesterId String
  status      ForkRequestStatus @default(PENDING)
  type        String            @default("fork")
  message     String?
  createdAt   DateTime          @default(now())
  respondedAt DateTime?
  workflow    Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  requester   User              @relation("ForkRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([workflowId, requesterId, type])
  @@index([workflowId])
  @@index([requesterId])
  @@index([status])
  @@map("workflow_fork_requests")
}

model WorkflowInstallation {
  id                  String   @id @default(uuid())
  templateId          String
  installedWorkflowId String   @unique
  installerId         String
  installedAt         DateTime @default(now())

  template            Workflow @relation("TemplateInstallations", fields: [templateId], references: [id], onDelete: Cascade)
  installedWorkflow   Workflow @relation("InstalledWorkflow", fields: [installedWorkflowId], references: [id], onDelete: Cascade)
  installer           User     @relation("UserInstallations", fields: [installerId], references: [id])

  @@index([templateId])
  @@index([installerId])
  @@map("workflow_installations")
}

enum ForkRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN
  USER
  VIEWER
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ToolCategory {
  WEB
  API
  DATABASE
  FILE
  CUSTOM
  MCP
}

enum ModelProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  AZURE
  OLLAMA
  CUSTOM
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum WorkflowVisibility {
  PRIVATE
  SHARED
  PUBLIC
}

enum CollaboratorRole {
  VIEWER
  EXECUTOR
  EDITOR
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum ChangeAction {
  CREATED
  NODE_ADDED
  NODE_UPDATED
  NODE_REMOVED
  EDGE_ADDED
  EDGE_REMOVED
  STATUS_CHANGED
  VISIBILITY_CHANGED
  SETTINGS_UPDATED
  FORKED
}

model ChatSession {
  id            String        @id @default(uuid())
  userId        String
  title         String        @default("New Chat")
  modelId       String?
  agentId       String?
  workflowId    String?
  tools         Json          @default("[]")
  systemPrompt  String?
  memoryContext Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      ChatMessage[]
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id            String      @id @default(uuid())
  sessionId     String
  role          String
  content       String
  attachments   Json?
  metadata      Json?
  toolCalls     Json?
  thinkingSteps Json?
  tokens        Int?
  createdAt     DateTime    @default(now())
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

model File {
  id              String              @id @default(uuid())
  userId          String
  originalName    String
  workspacePath   String? // Virtual path in the workspace
  storedName      String
  mimeType        String
  size            Int
  bucket          String
  key             String
  url             String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  indexingStatus  FileIndexingStatus?

  @@index([userId])
  @@index([workspacePath])
  @@map("files")
}

model FileIndexingStatus {
  fileId       String    @id
  status       String // 'idle', 'indexing', 'indexed', 'error'
  collectionId String?
  chunkCount   Int       @default(0)
  contentHash  String?
  error        String?
  indexedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  file         File      @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("file_indexing_statuses")
}

/// Stores Gmail push-notification watch subscriptions linked to workflows.
/// When a Pub/Sub push arrives, the orchestration service looks up all active
/// subscriptions for that Gmail account and fires the mapped workflow.
model GmailWatchSubscription {
  id           String    @id @default(uuid())
  /// Workflow to trigger when a new email arrives for this Gmail account
  workflowId   String
  /// userId that owns this subscription (used to run the workflow)
  userId       String
  /// Gmail email address being watched (used as the lookup key for incoming pushes)
  gmailUser    String
  /// Pub/Sub topic name used when registering with Gmail API
  topicName    String
  /// Gmail label IDs being watched (JSON array, e.g. ["INBOX"])
  labelIds     Json      @default("[\"INBOX\"]")
  /// Gmail historyId at the time the watch was created (used for history-based fetching)
  historyId    String?
  /// Unix-epoch ms when Google's watch subscription expires (max 7 days, must be renewed)
  expiration   String?
  /// Whether this subscription is currently active
  isActive     Boolean   @default(true)
  /// OAuth2 refresh token for the watched Gmail account (used to call Gmail History API)
  refreshToken String?
  /// JSON conditions for filtering which emails trigger the workflow
  /// Shape: { fromContains?, subjectContains?, bodyContains?, hasAttachment? }
  /// Empty object {} means "always trigger" (no filtering)
  conditions   Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workflow     Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, gmailUser])
  @@index([gmailUser])
  @@index([isActive])
  @@map("gmail_watch_subscriptions")
}
